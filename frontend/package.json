{
  "name": "ai-smart-reading",
  "version": "1.0.0",
  "description": "AI智慧阅读 - 纯离线单机智能阅读软件",
  "main": "main.js",
  "scripts": {
    "build:win": "bash ../scripts/build_package.sh win",
    "build:mac": "bash ../scripts/build_package.sh mac",
    "build:all": "bash ../scripts/build_package.sh all",
    "build": "vite build && sed -i '' 's/ crossorigin//g' dist_vue/index.html",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev"
  },
  "author": "Shinwell",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "echarts": "^6.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "antd": "^5.12.0",
    "pdfjs-dist": "3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^7.7.0"
  }
}
